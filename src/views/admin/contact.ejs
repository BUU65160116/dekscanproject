<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body>
   <%
// แปลง "YYYY-MM-DD HH:mm:ss" (UTC จาก Odoo) -> เวลาไทย
function toThaiLocal(utcStr) {
  if (!utcStr) return "-";
  try {
    const iso = String(utcStr).replace(" ", "T") + "Z"; // ชี้ว่าคือ UTC
    return new Date(iso).toLocaleString("th-TH", {
      timeZone: "Asia/Bangkok",
      hour12: false
    });
  } catch (e) {
    return utcStr; // ถ้าแปลงพลาด ให้โชว์ค่าดิบไว้ก่อน
  }
}
  %>
  <header>
    <h1>📇 ข้อมูลติดต่อ</h1>
  </header>

  <div class="wrap">
    <!-- การ์ดรายละเอียดออเดอร์ของโต๊ะที่เลือก -->
    <section class="card">
      <div class="card-head">
        <h2>โต๊ะ <%= order.tableNo ?? "-" %> | สถานะ: <%= order.state %></h2>
        <div class="actions">
          <a class="soft" href="/admin/dashboard">กลับ Dashboard</a>
        </div>
      </div>

      <!-- ตารางข้อมูลติดต่อ (ชื่อ/เบอร์) -->
      <table class="table">
        <thead>
          <tr>
            <th>ลูกค้า</th>
            <th>เบอร์</th>
          </tr>
        </thead>
        <tbody>
          <% if (contact) { %>
            <tr>
              <td><%= contact.name %></td>
              <td><%= contact.phone %></td>
            </tr>
          <% } else { %>
            <tr>
              <td colspan="2" class="muted">ไม่พบข้อมูลติดต่อล่าสุดของโต๊ะนี้</td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <!-- สรุปยอดค้าง + เวลา -->
      <div class="muted" style="margin-top:8px">
        ยอดค้าง:
        <strong><%= (order.amountTotal - order.amountPaid).toFixed(2) %>฿</strong>
        |
        เปิดออเดอร์: <%= toThaiLocal(order.dateOrderUtc) %>
      </div>

      
    </section>
  </div>
</body>
</html>