<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <title>รายละเอียดแต้ม</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- ชี้ไปที่ไฟล์สไตล์ points.css -->
  <link rel="stylesheet" href="/css/points.css" />
</head>
<body>
  <div class="container">
    <div class="card">
      <!-- ส่วนหัว + แต้มคงเหลือ -->
      <div class="header">
        <div class="title">รายละเอียดแต้ม</div>
        <div class="points-badge">
          <span>แต้มคงเหลือ</span>
          <span class="points-value"><%= points %></span>
        </div>
      </div>

      <!-- สถานะเช็คอินวันนี้ -->
      <% if (checkedInToday) { %>
        <div class="chip ok">เช็คอินวันนี้แล้ว</div>
      <% } else { %>
        <div class="chip warn">ยังไม่ได้เช็คอินวันนี้</div>
      <% } %>

      <!-- ปุ่มแลกของรางวัล -->
     <div class="section">
  <div class="grid">
    <!-- แลกส่วนลด 50 บาท -->
    <form method="POST" action="/points/redeem">
      <input type="hidden" name="rewardType" value="DISCOUNT50" />
      <button class="btn btn-primary redeem" <%= !canRedeem ? "disabled" : "" %>>
        <img class="redeem-ic" src="/img/discount.jpg" alt="ส่วนลด 50 บาท" />
        <span class="redeem-txt">
          <span class="title">แลกส่วนลด 50 บาท</span>
          <span class="sub">(ใช้ 10 แต้ม)</span>
        </span>
      </button>
    </form>

    <!--kulov  -->
    <form method="POST" action="/points/redeem">
      <input type="hidden" name="rewardType" value="ICE_BUCKET" />
      <button class="btn btn-primary redeem" <%= !canRedeem ? "disabled" : "" %>>
        <img class="redeem-ic" src="/img/ice.jpeg" alt="น้ำแข็ง 1 ถัง " />
        <span class="redeem-txt">
          <span class="title">น้ำแข็ง 1 ถัง</span>
          <span class="sub">(ใช้ 10 แต้ม)</span>
        </span>
      </button>
    </form>

    <!-- โค้ก 1 ขวด -->
    <form method="POST" action="/points/redeem">
      <input type="hidden" name="rewardType" value="COKE_1" />
      <button class="btn btn-primary redeem" <%= !canRedeem ? "disabled" : "" %>>
        <img class="redeem-ic" src="/img/mix.jpg" alt="โค้ก 1 ขวด " />
        <span class="redeem-txt">
          <span class="title">โค้ก 1 ขวด</span>
          <span class="sub">(ใช้ 10 แต้ม)</span>
        </span>
      </button>
    </form>
  </div>
</div>


      <!-- ประวัติแลกล่าสุด -->
      <div class="section">
        <div class="title" style="font-size:16px;">ประวัติแลกล่าสุด</div>

        <% if (redeemLogs && redeemLogs.length) { %>
          <% const it = redeemLogs[0]; %>
          <div class="table">
            <div class="table-row">
              <div class="table-key">วันที่</div>
              <div class="table-val"><%= new Date(it.CreatedAt).toLocaleDateString() %></div>
            </div>
            <div class="table-row">
              <div class="table-key">ของที่ได้</div>
              <div class="table-val"><%= it.Reward || "-" %></div>
            </div>
          </div>
        <% } else { %>
          <div class="chip">ยังไม่มีประวัติการแลก</div>
        <% } %>

        <!-- ปุ่มกลับหน้า Home -->
   <div class="footer-back">
  <a href="/home" class="back-link"><span class="arrow">←</span> กลับหน้า Home</a>
</div>

      </div>
    </div>
  </div>
</body>
</html>
