<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/screen.css" />
</head>
<body>
  <div class="screen-wrap">
    <!-- แถบบาร์ส่วนหัว -->
    <header class="screen-header header-bar">
      <div class="brand">
        <span class="dot"></span>
        <h1>จอร้าน</h1>
      </div>
      <div class="status">
        <span class="pill live">LIVE</span>
        <span id="clock" class="clock">--:--</span>
      </div>
    </header>

    <!-- เลย์เอาต์หลัก: ซ้ายใหญ่ (วาป) / ขวาแคบ (แชท) -->
    <main class="screen-grid grid--show-big">
  <!-- ซ้าย: วาป (ภาพเต็มพื้นที่) -->
  <section class="panel panel--warp warp-stage">
    <h2 class="panel-title sr-only">วาป</h2>
    <ul id="warpList" class="list">
      <li class="empty">ยังไม่มีวาป</li>
    </ul>
  </section>

  <!-- ขวา: แชท (sidebar โปร่ง เลื่อนเฉพาะแชท) -->
  <section class="panel panel--chat sidebar-chat">
    <h2 class="panel-title sticky">แชท <span class="dot dot-red"></span></h2>
    <ul id="chatList" class="list">
      <li class="empty">ยังไม่มีข้อความแชท</li>
    </ul>
  </section>
</main>

    <!-- แถบบาร์ด้านล่าง (Ticker) -->
    <footer class="screen-footer footer-bar">
  <div class="ticker" id="ticker">
    <div class="ticker-track">
      <span>ยินดีต้อนรับสู่ร้านของเรา • โปรดงดใช้คำหยาบและสแปม • ขอบคุณที่ให้ความร่วมมือ</span>
      <span>ยินดีต้อนรับสู่ร้านของเรา • โปรดงดใช้คำหยาบและสแปม • ขอบคุณที่ให้ความร่วมมือ</span>
    </div>
  </div>
</footer>
  </div>

  <script>
    // นาฬิกามุมขวาบน
    const elClock = document.getElementById("clock");
    const pad = n => n.toString().padStart(2,"0");
    function tick(){ const d=new Date(); elClock.textContent=`${pad(d.getHours())}:${pad(d.getMinutes())}`; }
    setInterval(tick, 1000); tick();
  </script>

  <!-- Socket.IO -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    // ====== โค้ดเดิม: แชท + วาป (ไม่เปลี่ยน) ======
    const socket = io();
    const esc = (s) => (s || "").toString().replace(/</g,"&lt;").replace(/>/g,"&gt;");
    const chatList = document.getElementById("chatList");
    const warpList = document.getElementById("warpList");

    async function loadHistory(){
      try{
        const res = await fetch("/screen/history");
        const json = await res.json();
        if(!json.ok) return;

        chatList.innerHTML = "";
        [...json.data].reverse().forEach(it => {
          const li = document.createElement("li");
          li.className = "item";
          li.dataset.id = it.chatId;
          li.id = `chat-${it.chatId}`;
          li.innerHTML = `
            <span class="name">โต๊ะ ${it.tableId || "-"}</span>
            <span class="msg">${esc(it.message)}</span>
          `;
          chatList.appendChild(li);
        });

        if(!chatList.children.length){
          chatList.innerHTML = `<li class="empty">ยังไม่มีข้อความแชท</li>`;
        }
      }catch(e){ console.error(e); }
    }
    loadHistory();

    socket.on("newMessage", (data) => {
      const empty = chatList.querySelector(".empty");
      if (empty) empty.remove();
      const li = document.createElement("li");
      li.className = "item";
      if (typeof data.chatId !== "undefined") {
        li.dataset.id = data.chatId;
        li.id = `chat-${data.chatId}`;
      }
      li.innerHTML = `
        <span class="name">โต๊ะ ${data.tableId || "-"}</span>
        <span class="msg">${esc(data.message)}</span>
      `;
      chatList.appendChild(li);
    });

    socket.on("deleteMessage", ({ chatId }) => {
      const el = document.getElementById(`chat-${chatId}`);
      if (el) el.remove();
      if (!chatList.querySelector(".item")) {
        chatList.innerHTML = `<li class="empty">ยังไม่มีข้อความแชท</li>`;
      }
    });

    socket.on("clearChat", () => {
      chatList.innerHTML = `<li class="empty">ยังไม่มีข้อความแชท</li>`;
    });

    // ===== แจกวาป (ฝั่งจอใหญ่) =====
    function safeImgSrc(item){
      const raw = (item.ImageURL ?? item.imageUrl ?? item.image ?? "").toString().trim();
      if (/^data:image\/(png|jpe?g|gif|webp);base64,/i.test(raw)) return raw;
      return "";
    }

    function renderWarpNow(item){
      const msg = (item.Message ?? item.message ?? "");
      const src = safeImgSrc(item);

      if (!src) { // ไม่มีรูป → โชว์ข้อความล้วนกลางจอ
        warpList.innerHTML = `
          <li class="item warp-now">
            <p class="warp-only-text">${esc(msg)}</p>
          </li>`;
        return;
      }

      // preload รูปก่อน แล้วค่อยใส่ DOM
      const img = new Image();
      img.className = "warp-img";
      img.onload = () => {
        warpList.innerHTML = `
          <li class="item warp-now">
            <img src="${src}" class="warp-img" />
          </li>`;
      };
      img.onerror = () => {
        warpList.innerHTML = `
          <li class="item warp-now">
            <p class="warp-only-text">${esc(msg)}</p>
          </li>`;
      };
      img.src = src;
    }

    socket.on("warp:now", (item) => { renderWarpNow(item); });
    socket.on("warp:done", () => { warpList.innerHTML = `<li class="empty">รอคิวถัดไป...</li>`; });
  </script>
</body>
</html>
