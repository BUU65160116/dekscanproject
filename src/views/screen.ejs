<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/screen.css" />
  <style>
    /* ป้องกันรูปหลุดเฟรม/เบี้ยว และทับข้อความ */
    .warp-now{ position:relative; }
    .warp-img{
      display:block;
      width:100%;
      height:auto;
      object-fit:contain;
      background:#000;
      border-radius: 8px;
    }
    .warp-msg{
      margin-top:.5rem;
      font-size:1.25rem;
      line-height:1.35;
      word-break: break-word;
    }
  </style>
</head>
<body>
  <div class="screen-wrap">
    <header class="screen-header">
      <div class="brand">
        <span class="dot"></span>
        <h1>Chat & Warp Board</h1>
      </div>
      <div class="status">
        <span class="pill live">LIVE</span>
        <span id="clock" class="clock">--:--</span>
      </div>
    </header>

    <main class="screen-grid">
      <!-- คอลัมน์ซ้าย: แชท -->
      <section class="panel">
        <h2 class="panel-title">แชท</h2>
        <ul id="chatList" class="list">
          <li class="empty">ยังไม่มีข้อความแชท</li>
        </ul>
      </section>

      <!-- คอลัมน์ขวา: วาป -->
      <section class="panel">
        <h2 class="panel-title">วาป</h2>
        <ul id="warpList" class="list">
          <li class="empty">ยังไม่มีวาป</li>
        </ul>
      </section>
    </main>

    <footer class="screen-footer">
      <div class="ticker" id="ticker">
        <div class="ticker-track">
          <span>ยินดีต้อนรับสู่ร้านของเรา • โปรดงดใช้คำหยาบและสแปม • ขอบคุณที่ให้ความร่วมมือ</span>
          <span>ยินดีต้อนรับสู่ร้านของเรา • โปรดงดใช้คำหยาบและสแปม • ขอบคุณที่ให้ความร่วมมือ</span>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // นาฬิกามุมขวาบน
    const elClock = document.getElementById("clock");
    function pad(n){ return n.toString().padStart(2,"0"); }
    function tick(){
      const d = new Date();
      elClock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }
    setInterval(tick, 1000); tick();
  </script>

  <!-- Socket.IO -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const esc = (s) => (s || "").toString().replace(/</g,"&lt;").replace(/>/g,"&gt;");
    const chatList = document.getElementById("chatList");
    const warpList = document.getElementById("warpList");// อ้างอิงลิสต์ฝั่งวาป

    // โหลดประวัติแชท
    async function loadHistory(){
      try{
        const res = await fetch("/screen/history");
        const json = await res.json();
        if(!json.ok) return;

        chatList.innerHTML = "";
        [...json.data].reverse().forEach(it => {
          const li = document.createElement("li");
          li.className = "item";
          li.dataset.id = it.chatId;
          li.id = `chat-${it.chatId}`;
          li.innerHTML = `
            <span class="name">โต๊ะ ${it.tableId || "-"}</span>
            <span class="msg">${esc(it.message)}</span>
          `;
          chatList.appendChild(li);
        });

        if(!chatList.children.length){
          chatList.innerHTML = `<li class="empty">ยังไม่มีข้อความแชท</li>`;
        }
      }catch(e){ console.error(e); }
    }
    loadHistory();

    // ข้อความใหม่ (realtime)
    socket.on("newMessage", (data) => {
      const empty = chatList.querySelector(".empty");
      if (empty) empty.remove();

      const li = document.createElement("li");
      li.className = "item";
      if (typeof data.chatId !== "undefined") {
        li.dataset.id = data.chatId;
        li.id = `chat-${data.chatId}`;
      }
      li.innerHTML = `
        <span class="name">โต๊ะ ${data.tableId || "-"}</span>
        <span class="msg">${esc(data.message)}</span>
      `;
      chatList.appendChild(li);
    });

    // ลบข้อความเดี่ยว (realtime)
    socket.on("deleteMessage", ({ chatId }) => {
      const el = document.getElementById(`chat-${chatId}`);
      if (el) el.remove();
      if (!chatList.querySelector(".item")) {
        chatList.innerHTML = `<li class="empty">ยังไม่มีข้อความแชท</li>`;
      }
    });

    // ล้างทั้งหมด (realtime)
    socket.on("clearChat", () => {
      chatList.innerHTML = `<li class="empty">ยังไม่มีข้อความแชท</li>`;
    });

     // ===== แจกวาป (ฝั่งจอใหญ่) =====

   // ตรวจ/เลือก src รูปให้ปลอดภัย: รองรับ key หลายแบบ + trim + ต้องเป็น data:image/...;base64
  function safeImgSrc(item){
    const raw = (item.ImageURL ?? item.imageUrl ?? item.image ?? "").toString().trim();
    if (/^data:image\/(png|jpe?g|gif|webp);base64,/i.test(raw)) return raw;
    return "";
  }

  // แสดงวาป (preload ก่อนค่อยใส่ DOM) + มี log ให้ไล่ปัญหา
  function renderWarpNow(item){
    const msg   = (item.Message ?? item.message ?? "");
    const secs  = (item.DurationSec ?? item.durationSec ?? 15);
    const table = (item.TableID ?? item.tableId ?? "-");
    const src   = safeImgSrc(item);

    // ไม่มีรูป → ข้อความล้วน
    if (!src) {
      console.warn("[warp] no/invalid image, show text only", {
        hasImage: !!(item.ImageURL || item.imageUrl || item.image),
        len: (item.ImageURL || item.imageUrl || item.image || "").length
      });
      warpList.innerHTML = `
        <li class="item warp-now">
          <p class="warp-msg">${esc(msg)}</p>
          <small>โต๊ะ ${table} · เหลือเวลา ~${secs}s</small>
        </li>`;
      return;
    }

    // preload รูปก่อน
    const img = new Image();
    img.className = "warp-img";
    img.onload = () => {
      warpList.innerHTML = `
        <li class="item warp-now">
          <img src="${src}" class="warp-img" />
          <p class="warp-msg">${esc(msg)}</p>
          <small>โต๊ะ ${table} · เหลือเวลา ~${secs}s</small>
        </li>`;
    };
    img.onerror = (e) => {
      console.warn("[warp] image load failed → fallback to text", { err:e, len:src.length });
      warpList.innerHTML = `
        <li class="item warp-now">
          <p class="warp-msg">${esc(msg)}</p>
          <small>โต๊ะ ${table} · เหลือเวลา ~${secs}s</small>
        </li>`;
    };
    img.src = src; // เริ่มโหลด
  }

  // realtime: ได้คิวโชว์ตอนนี้
  socket.on("warp:now", (item) => {
    console.debug("[warp:now]", {
      hasImage: !!(item.ImageURL || item.imageUrl || item.image),
      len: (item.ImageURL || item.imageUrl || item.image || "").length,
      table: item.TableID ?? item.tableId,
      dur: item.DurationSec ?? item.durationSec
    });
    renderWarpNow(item);
  });

  // realtime: จบเวลา → ล้างหน้าจอฝั่งวาป
  socket.on("warp:done", () => {
    warpList.innerHTML = `<li class="empty">รอคิวถัดไป...</li>`;
  });
  </script>
</body>
</html>
