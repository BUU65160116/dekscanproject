<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Home • <%= shop %></title>
  <link rel="stylesheet" href="/home.css" />
</head>
<body>
  <div class="container">

    <!-- HERO PUBCAST STYLE -->
    <section class="hero hero--no-text">
      <div class="hero-top no-phone">
        <div class="hero-text">
          <div class="hero-welcome-top">
            คุณ <strong><%= user.Name %></strong> • <strong><%= shop %></strong> ยินดีต้อนรับ
          </div>
        </div>
      </div>

      <div class="hero-bottom hero-bottom--info">
        <ul class="hb-list">
          <li><span>เบอร์โทร:</span> <%= user.PhoneNumber %></li>
          <li><span>โต๊ะ:</span> <%= table %></li>
          <li>
            <span>แต้มสะสม:</span>
            <span class="points"><%= points %></span>
            <% if (checkedInToday) { %>
              <div class="chip chip-ok">เช็คอินวันนี้แล้ว</div>
            <% } else { %>
              <div class="chip chip-warn">ยังไม่ได้เช็คอินวันนี้</div>
            <% } %>
          </li>
        </ul>
      </div>
    </section>
    <!-- /HERO -->

    <!-- เมนูหลัก -->
    <section class="tile-area">
      <a class="promo-banner" href="/warp">
        <div class="promo-text">
          <div class="t1">ส่งรูปคุณให้ทั้งร้านเห็น! ✨</div>
          <div class="t2">เพียงสั่งครบ 250 บาท ก็ขึ้นจอได้ทันที</div>
        </div>
      </a>

      <div class="tile-grid two">
        <!-- แลกของรางวัล -->
       <a class="tile redeem" href="/points">
  <div class="tile-icon redeem-ic">
    <img class="tile-img" src="/img/1.png" alt="แลกของรางวัล">
  </div>
  <div class="tile-title">แลกของรางวัล</div>
</a>


        <!-- เข้าแชทเรียลไทม์ -->
       <a class="tile chat" href="/chat">
  <div class="tile-icon chat-ic">
    <img class="tile-img" src="/img/2.png" alt="เข้าแชทเรียลไทม์">
  </div>
  <div class="tile-title">เข้าแชทเรียลไทม์</div>
</a>

      <div class="aux-row">
        <a class="btn-danger" href="/logout">ออกจากระบบ</a>
      </div>
    </section>
  </div>
</body>
</html>
