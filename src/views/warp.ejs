<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || "แจกวาป" %></title>
  <link rel="stylesheet" href="/warp.css" />
  <!-- ไม่มี overlay/loader เพิ่มเติม -->
</head>

<body>
  <div class="wrap">
    <header class="hero">
      <h1>แจกวาป</h1>
    </header>

    <!-- ===== แถบเครดิต + ปุ่มเช็คสิทธิ์ ===== -->
    <div class="creditbar">
      <div class="credits">สิทธิ์คงเหลือ: <strong id="left">-</strong></div>
      <button id="btnCheck" class="btn btn-outline">เช็คสิทธิ์</button>
      <span id="statusInline" class="status-inline"></span>
      <div class="sub">กรุณา <b>กดเช็คสิทธิ์ก่อนส่ง</b> เพื่ออัปเดตสิทธิ์ล่าสุด</div>
    </div>

    <!-- ===== ฟอร์มส่งวาป ===== -->
    <section class="card">
      <p class="hint">เลือกภาพจากมือถือ แล้วพิมพ์ข้อความบนรูป (สูงสุด 20 ตัวอักษร)</p>

      <div class="field">
        <label>เลือกรูป</label>
        <input id="file" type="file" accept="image/*" />
        <div class="count" style="text-align:left;color:var(--muted)">แนะนำไม่เกิน ~5MB, ระบบจะย่ออัตโนมัติ</div>
      </div>

      <div class="field">
        <label>ข้อความบนรูป</label>
        <input id="msg" type="text" maxlength="20" placeholder="พิมพ์ข้อความ / แคปชัน / IG" />
        <div class="count"><span id="count">0</span>/20</div>
      </div>

      <!-- พรีวิวรูป -->
      <div id="preview" class="preview" style="display:none">
        <canvas id="canvas"></canvas>
      </div>

      <!-- ปุ่มส่ง -->
      <div class="actions">
        <button id="btnSend" class="btn btn-primary" disabled>ส่งวาป</button>
      </div>

      <!-- สถานะหลัก -->
      <div id="status" class="status"></div>
    </section>

    <!-- ===== ปุ่มกลับหน้า Home ===== -->
    <p class="back">
      <a href="/home" class="btn-back">
        <span class="icon">←</span> กลับหน้า Home
      </a>
    </p>
  </div>

  <script>
    /* ============================
       DOM refs
    ============================ */
    const elLeft    = document.getElementById('left');
    const elMsg     = document.getElementById('msg');
    const elCount   = document.getElementById('count');
    const elFile    = document.getElementById('file');
    const elPreview = document.getElementById('preview');
    const elCanvas  = document.getElementById('canvas');
    const ctx       = elCanvas.getContext('2d');
    const elSend    = document.getElementById('btnSend');
    const elCheck   = document.getElementById('btnCheck');
    const elStatus  = document.getElementById('status');
    const elStatusInline = document.getElementById('statusInline');

    const esc = (s)=> (s||"").toString().replace(/</g,"&lt;").replace(/>/g,"&gt;");

    let baseImage = null;
    let composedDataURL = null;

    /* ============================
       helper: ตัดบรรทัดข้อความ
    ============================ */
    function breakLines(context, text, maxWidth){
      const words=(text||"").split(/\s+/).filter(Boolean);
      const lines=[]; let line="";
      for(const w of words){
        const test=line? line+" "+w : w;
        if(context.measureText(test).width<=maxWidth) line=test;
        else{ if(line) lines.push(line); line=w; }
      }
      if(line) lines.push(line);
      return lines.length? lines : [""]; 
    }

    /* ============================
       helper: วาดกล่องโค้ง
    ============================ */
    function roundRect(ctx,x,y,w,h,r){
      const rr=Math.min(r,w/2,h/2);
      ctx.beginPath();
      ctx.moveTo(x+rr,y);
      ctx.arcTo(x+w,y,  x+w,y+h, rr);
      ctx.arcTo(x+w,y+h,x,  y+h, rr);
      ctx.arcTo(x,  y+h,x,  y,   rr);
      ctx.arcTo(x,  y,  x+w,y,   rr);
      ctx.closePath();
    }

    /* ============================
       วาดข้อความบนรูป (ชัดขึ้น)
    ============================ */
    function drawToCanvasWithText(img,text){
      const MAX_W = 1440;
      const ratio = img.width > MAX_W ? (MAX_W / img.width) : 1;
      const wCSS  = Math.round(img.width * ratio);
      const hCSS  = Math.round(img.height * ratio);
      const DPR   = Math.max(1, Math.min(2, window.devicePixelRatio || 1));

      elCanvas.width  = Math.round(wCSS * DPR);
      elCanvas.height = Math.round(hCSS * DPR);
      elCanvas.style.width  = wCSS + "px";
      elCanvas.style.height = hCSS + "px";
      ctx.setTransform(DPR,0,0,DPR,0,0);

      ctx.clearRect(0,0,wCSS,hCSS);
      ctx.drawImage(img, 0, 0, wCSS, hCSS);

      const fontSize   = Math.max(28, Math.round(wCSS * 0.055));
      const lineHeight = Math.round(fontSize * 1.25);
      const maxWidth   = Math.round(wCSS * 0.9);

      ctx.font = `900 ${fontSize}px 'Noto Sans Thai', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif`;
      ctx.textAlign   = "center";
      ctx.textBaseline= "top";

      const lines  = breakLines(ctx, (text||"").trim(), maxWidth);
      const startY = Math.round(hCSS * 0.80 - (lines.length * lineHeight) / 2);

      const widths = lines.map(l => ctx.measureText(l).width);
      const boxW   = Math.min(maxWidth, Math.max(...widths) + Math.round(fontSize * .8));
      const boxH   = lines.length * lineHeight + Math.round(fontSize * .6);
      ctx.fillStyle = "rgba(0,0,0,0.55)";
      roundRect(ctx, (wCSS - boxW)/2, startY - Math.round(fontSize*.3), boxW, boxH, Math.round(fontSize*.3));
      ctx.fill();

      ctx.fillStyle   = "#fff";
      ctx.strokeStyle = "#000";
      ctx.lineWidth   = Math.max(3, Math.round(fontSize * 0.06));
      ctx.shadowColor = "rgba(0,0,0,0.9)";
      ctx.shadowBlur  = Math.round(fontSize / 4);

      lines.forEach((l,i)=>{
        const y = startY + i*lineHeight;
        ctx.strokeText(l, Math.round(wCSS/2), y);
        ctx.fillText  (l, Math.round(wCSS/2), y);
      });

      composedDataURL = elCanvas.toDataURL("image/jpeg", .85);
    }

    /* ============================
       input: นับตัวอักษร + อัปเดตพรีวิว
    ============================ */
    elMsg.addEventListener('input', ()=>{
      elCount.textContent = elMsg.value.length;
      if(baseImage) drawToCanvasWithText(baseImage, elMsg.value);
    });

    /* ============================
       upload: โหลดรูป → พรีวิว
    ============================ */
    elFile.addEventListener('change', e=>{
      const f = e.target.files && e.target.files[0];
      if(!f){ baseImage=null; composedDataURL=null; elPreview.style.display='none'; return; }
      if(f.size > 20*1024*1024){
        elStatus.textContent='';
        elStatusInline.innerHTML='<span class="err">ไฟล์ใหญ่เกินไป (&gt;20MB)</span>';
        elFile.value='';
        return;
      }
      const reader=new FileReader();
      reader.onload=()=>{
        const img=new Image();
        img.onload=()=>{ baseImage=img; elPreview.style.display='block'; drawToCanvasWithText(img, elMsg.value); };
        img.onerror=()=>{ elStatusInline.innerHTML='<span class="err">โหลดรูปไม่สำเร็จ</span>'; };
        img.src=reader.result;
      };
      reader.readAsDataURL(f);
    });

    /* ============================
       เช็คสิทธิ์ (ต้องกดก่อนส่ง)
    ============================ */
    async function refreshCredits(){
      elStatusInline.textContent = 'กำลังเช็คสิทธิ์...';
      elCheck.disabled = true;
      elSend.disabled  = true;
      try{
        const r = await fetch('/warp/credits?recalc=1', {cache:'no-store'});
        const j = await r.json();
        if(!j.ok) throw new Error(j.error || 'error');
        elLeft.textContent = j.data.left;
        elStatusInline.innerHTML = '<span class="ok">อัปเดตแล้ว</span>';
      }catch(err){
        elStatusInline.innerHTML = '<span class="err">เช็คสิทธิ์ไม่สำเร็จ: '+ esc(err.message||err) +'</span>';
      }finally{
        const left = Number(elLeft.textContent || 0);
        elSend.disabled  = !(left > 0);
        elCheck.disabled = false;
      }
    }
    refreshCredits();//เช็คก่อนครั้งเเรก

    /* ============================
       ส่งวาป (เวอร์ชันเดิม ไม่มี overlay)
    ============================ */
    async function submitWarp(){
      const left = Number(elLeft.textContent || NaN);
      if(Number.isNaN(left)){
        elStatusInline.innerHTML = '<span class="err">กรุณาเช็คสิทธิ์ก่อนส่ง</span>';
        return;
      }
      if(left <= 0){
        elStatusInline.innerHTML = '<span class="err">สิทธิ์หมด กรุณาเช็คอีกครั้ง</span>';
        return;
      }
      const message = (elMsg.value || '').trim();
      if(!message){
        elStatus.innerHTML = '<span class="err">กรุณากรอกข้อความ</span>';
        elMsg.focus();
        return;
      }

      // แสดงสถานะแบบเดิม (ไม่ใช้ overlay)
      elSend.disabled = true;
      elStatus.textContent = 'กำลังส่ง...';

      try{
        const r = await fetch('/warp/use', {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ message, imageUrl: composedDataURL || null })
        });
        const j = await r.json();
        if(!j.ok) throw new Error(j.error || 'ส่งไม่สำเร็จ');

        elLeft.textContent = j.left;
        elStatus.innerHTML = `<span class="ok">สิทธิ์คงเหลือ: ${j.left}</span>`;

        // เคลียร์ฟอร์ม
        elMsg.value=''; elCount.textContent=0; elFile.value='';
        baseImage=null; composedDataURL=null; elPreview.style.display='none';
      }catch(err){
        elStatus.innerHTML = `<span class="err">${esc(err.message||err)}</span>`;
      }finally{
        const newLeft = Number(elLeft.textContent || 0);
        elSend.disabled = !(newLeft > 0);
      }
    }

    // ===== ผูกปุ่ม =====
    elCheck.addEventListener('click', refreshCredits);
    elSend.addEventListener('click', submitWarp);
  </script>
</body>
</html>