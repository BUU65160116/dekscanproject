<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || "แจกวาป" %></title>

  <!-- ใช้ไฟล์ warp.css เดิม -->
  <link rel="stylesheet" href="/warp.css" />
  <style>
    /* พรีวิวรูป + ข้อความซ้อนบนรูป */
    .preview{
      position: relative;
      margin-top: 12px;
      border: 1px dashed #ddd;
      border-radius: 12px;
      overflow: hidden;
      background: #fafafa;
    }
    .preview canvas{ display:block; width:100%; height:auto; }

    .controls{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    .filetip{ font-size:.9rem; color:#666; }
    .status .ok{ color:#17c964; }
    .status .err{ color:#ff4d4f; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <h1>แจกวาป</h1>
      <div class="credits">สิทธิ์คงเหลือ: <span id="left" class="muted">-</span></div>
    </div>

    <section class="card">
      <p class="hint">เลือกภาพจากมือถือ แล้วพิมพ์ข้อความบนรูป (สูงสุด 20 ตัวอักษร)</p>

      <!-- เลือกรูปจากเครื่อง -->
      <div class="field">
        <label class="muted">เลือกรูป</label>
        <div class="controls">
          <input id="file" type="file" accept="image/*" />
          <span class="filetip">แนะนำไม่เกิน ~5MB, ระบบจะย่ออัตโนมัติ</span>
        </div>
      </div>

      <!-- พิมพ์ข้อความ -->
      <div class="field">
        <label class="muted">ข้อความบนรูป</label>
        <input id="msg" type="text" maxlength="20" placeholder="พิมพ์ข้อความ / แคปชัน / IG " />
        <div class="muted right"><span id="count">0</span>/20คำ</div>
      </div>

      <!-- พรีวิว (ภาพพร้อมข้อความซ้อน) -->
      <div id="preview" class="preview" style="display:none">
        <canvas id="canvas"></canvas>
      </div>

      <!-- ปุ่ม -->
      <div class="row" style="margin-top:12px">
        <button id="btnSend">ส่งวาป</button>
        <button id="btnCheck" class="soft">เช็คสิทธิ์</button>
      </div>

      <!-- สถานะ -->
      <div id="status" class="status"></div>
    </section>

    <p class="muted footnote">
      เมื่อส่งสำเร็จ ข้อความจะไปเข้าคิวและถูกฉายบนจอใหญ่ ~<%= process.env.WARP_SLIDE_SECONDS || 15 %> วินาที/ครั้ง
    </p>
    <p class="back"><a href="/home">← กลับหน้า Home</a></p>
  </div>

  <script>
    // ===== อ้างอิง DOM =====
    const elLeft    = document.getElementById('left');
    const elMsg     = document.getElementById('msg');
    const elCount   = document.getElementById('count');
    const elFile    = document.getElementById('file');
    const elPreview = document.getElementById('preview');
    const elCanvas  = document.getElementById('canvas');
    const ctx       = elCanvas.getContext('2d');
    const elSend    = document.getElementById('btnSend');
    const elCheck   = document.getElementById('btnCheck');
    const elStatus  = document.getElementById('status');

    const esc = (s)=> (s||"").toString().replace(/</g,"&lt;").replace(/>/g,"&gt;");

    // ===== สถานะรูป/ข้อความในหน้านี้ =====
    let baseImage = null;         // HTMLImageElement ของรูปดิบ
    let composedDataURL = null;   // data:image/... ที่ซ้อนข้อความแล้ว (พร้อมส่ง)

    // ===== ตัวช่วยตัดบรรทัด (ตามความกว้าง) =====
    function breakLines(context, text, maxWidth){
      const words = (text||"").split(/\s+/).filter(Boolean);
      const lines = [];
      let line = "";
      for(const word of words){
        const test = line ? (line + " " + word) : word;
        if(context.measureText(test).width <= maxWidth){
          line = test;
        }else{
          if(line) lines.push(line);
          line = word;
        }
      }
      if(line) lines.push(line);
      if(lines.length === 0) lines.push(""); // กรณีว่าง ให้มี 1 บรรทัด
      return lines;
    }

    // ===== วาดภาพลง canvas + ซ้อนข้อความ =====
    function roundRect(ctx, x, y, w, h, r){
      const radius = Math.min(r, w/2, h/2);
      ctx.beginPath();
      ctx.moveTo(x+radius, y);
      ctx.arcTo(x+w, y,   x+w, y+h, radius);
      ctx.arcTo(x+w, y+h, x,   y+h, radius);
      ctx.arcTo(x,   y+h, x,   y,   radius);
      ctx.arcTo(x,   y,   x+w, y,   radius);
      ctx.closePath();
    }

    function drawToCanvasWithText(img, text){
      // 1) resize เพื่อลดขนาด payload (ภาพมือถือมัก 3–4K px)
      const MAX_W = 1280;
      const ratio = img.width > MAX_W ? (MAX_W / img.width) : 1;
      const w = Math.round(img.width * ratio);
      const h = Math.round(img.height * ratio);

      elCanvas.width = w;
      elCanvas.height = h;

      ctx.clearRect(0,0,w,h);
      ctx.drawImage(img, 0, 0, w, h);

      // 2) คำนวณตำแหน่งข้อความ: ต่ำกว่ากึ่งกลางลงมาประมาณ 30%
      const fontSize   = Math.max(24, Math.round(w * 0.045));
      const lineHeight = Math.round(fontSize * 1.25);
      const maxWidth   = Math.round(w * 0.9);

      ctx.font = `600 ${fontSize}px system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans Thai', sans-serif`;
      ctx.textAlign = "center";
      ctx.textBaseline = "top";

      const lines = breakLines(ctx, text, maxWidth);
      const startY = Math.round(h * 0.80 - (lines.length * lineHeight)/2);

      // กล่องพื้นหลังช่วยให้อ่านง่าย
      const widths = lines.map(line => ctx.measureText(line).width);
      const boxW   = Math.min(maxWidth, Math.max(...widths) + Math.round(fontSize*0.8));
      const boxH   = lines.length * lineHeight + Math.round(fontSize*0.6);

      ctx.fillStyle = "rgba(255,255,255,0.35)";
      ctx.shadowColor = "transparent";
      roundRect(ctx, (w-boxW)/2, startY - Math.round(fontSize*0.3), boxW, boxH, Math.round(fontSize*0.3));
      ctx.fill();

      // เงา + สีข้อความ
      ctx.fillStyle = "#111";
      ctx.shadowColor = "rgba(255,255,255,0.65)";
      ctx.shadowBlur = Math.round(fontSize/5);

      lines.forEach((line, i) => {
        ctx.fillText(line, Math.round(w/2), startY + i*lineHeight);
      });

      // 3) export เป็น JPEG (เล็กกว่า PNG มาก) คุณภาพ ~82%
      composedDataURL = elCanvas.toDataURL("image/jpeg", 0.82);
    }

    // ===== events =====
    // เปลี่ยนนับอักษร + re-render เมื่อพิมพ์ข้อความ
    elMsg.addEventListener('input', () => {
      elCount.textContent = elMsg.value.length;
      if(baseImage){
        drawToCanvasWithText(baseImage, elMsg.value.trim());
      }
    });

    // เลือกรูปใหม่ → อ่านเป็น dataURL → โหลดเป็น <img> → วาดลง canvas
    elFile.addEventListener('change', async (e) => {
      const f = e.target.files && e.target.files[0];
      if(!f){
        baseImage = null; composedDataURL = null; elPreview.style.display='none';
        return;
      }

      // ป้องกันไฟล์ใหญ่มาก ๆ ตั้งแต่ต้น (กันพลาด)
      if (f.size > 20 * 1024 * 1024) { // >20MB
        elStatus.innerHTML = '<span class="err">ไฟล์ใหญ่เกินไป (จำกัด ~20MB)</span>';
        elFile.value = '';
        return;
      }

      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          baseImage = img;
          elPreview.style.display = 'block';
          drawToCanvasWithText(img, elMsg.value.trim());
        };
        img.onerror = () => {
          elStatus.innerHTML = '<span class="err">โหลดรูปไม่สำเร็จ</span>';
        };
        img.src = reader.result;
      };
      reader.readAsDataURL(f);
    });

    // ดึงเครดิตคงเหลือ ( ปรับให้มี delay 3 วิ + รีคาลก์จากเซิร์ฟเวอร์)
    async function refreshCredits(){
      elStatus.textContent = 'กำลังเช็คสิทธิ์...';
      elCheck.disabled = true;
      elSend.disabled  = true;

      try{
        // หน่วง ~3 วิ ให้ผู้ใช้รู้สึกว่ากำลังอัปเดตจริง
        await new Promise(r => setTimeout(r, 3000));

        // ขอรีคาลก์จาก Odoo แล้วคืนค่า (ใช้ ?recalc=1)
        const r = await fetch('/warp/credits?recalc=1');
        const j = await r.json();
        if(!j.ok) throw new Error(j.error || 'error');
        elLeft.textContent = j.data.left;
        elStatus.innerHTML = '<span class="ok">อัปเดตสิทธิ์ล่าสุดแล้ว</span>';
      }catch(err){
        elStatus.innerHTML = '<span class="err">เช็คสิทธิ์ไม่สำเร็จ: '+ esc(err.message||err) +'</span>';
      }finally{
        const left = Number(elLeft.textContent || 0);
        elSend.disabled  = (left <= 0);
        elCheck.disabled = false;
      }
    }

    // ส่งวาป (ส่งรูปที่ซ้อนข้อความแล้ว ถ้ามี)
    async function submitWarp(){
      const message = elMsg.value.trim();
      if(message.length === 0){
        elStatus.innerHTML = '<span class="err">กรุณากรอกข้อความ</span>';
        elMsg.focus(); return;
      }
      const imageUrl = composedDataURL || null;   // อาจไม่มีรูป

      elSend.disabled = true;
      elStatus.textContent = 'กำลังส่ง...';
      try{
        const r = await fetch('/warp/use', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, imageUrl })
        });
        const j = await r.json();
        if(!j.ok) throw new Error(j.error || 'ส่งไม่สำเร็จ');

        elStatus.innerHTML = '<span class="ok">ส่งสำเร็จ! คิว #' + j.queueId + ' | สิทธิ์คงเหลือ: ' + j.left + '</span>';
        elLeft.textContent = j.left;

        // รีโหลดอัตโนมัติหลัง 5 วิ (ปรับได้)
        setTimeout(() => location.reload(), 5000);

        // เคลียร์ฟอร์ม
        elMsg.value = ''; elCount.textContent = 0;
        elFile.value = ''; baseImage = null; composedDataURL = null;
        elPreview.style.display = 'none';
      }catch(err){
        elStatus.innerHTML = '<span class="err">'+ esc(err.message||err) +'</span>';
      }finally{
        const left = Number(elLeft.textContent || 0);
        elSend.disabled = (left <= 0);
      }
    }

    elCheck.addEventListener('click', refreshCredits);
    elSend.addEventListener('click', submitWarp);

    // เริ่มต้น: แสดงจำนวนสิทธิ์ล่าสุดด้วยการรีคาลก์ครั้งแรก (ถ้าไม่ต้องการ ให้คอมเมนต์)
    refreshCredits();
  </script>
</body>
</html>
